{% from "_icons.html.j2" import icon %}
<footer class="bg-olive-dark text-olive-fg">
  <div class="container-wide grid gap-10 py-14 text-sm md:grid-cols-3">
    <div>
      <p class="font-display text-3xl">{{ site.name }}</p>
      <p class="mt-2 opacity-80">{{ page.footer.tagline }}</p>
    </div>
    <div class="space-y-3">
      <p class="opacity-90">{{ page.footer.location }}</p>
      <p><a href="mailto:{{ site.email }}" class="inline-flex items-center gap-2 hover:text-peach">{{ icon("mail", "h-4 w-4") }}{{ site.email }}</a></p>
      <p><a href="{{ site.instagram_url }}" target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-peach">{{ icon("instagram", "h-4 w-4") }}@villa_elcarmen_puglia</a></p>
    </div>
    <div class="space-y-1 md:text-right">
      <p>{{ page.footer.cin_label }}: <span class="font-medium">{{ site.cin }}</span></p>
      <p>{{ page.footer.cis_label }}: <span class="font-medium">{{ site.cis }}</span></p>
      <ul class="flex flex-wrap gap-x-4 gap-y-1 pt-4 md:justify-end" aria-label="{{ page.nav.languages }}">
        {% for language in site.languages %}
        <li><a href="{{ language.path }}" hreflang="{{ language.code }}" lang="{{ language.code }}" class="hover:text-peach">{{ language.label }}</a></li>
        {% endfor %}
      </ul>
      <p class="pt-4 opacity-70">&copy; {{ year }} {{ site.name }}. {{ page.footer.rights }}</p>
    </div>
  </div>
</footer>
