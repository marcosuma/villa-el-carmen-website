{% from "_icons.html.j2" import icon %}
<header class="site-header">
  <div class="container-wide flex flex-wrap items-center justify-between gap-x-4 py-3">
    <a class="flex items-center gap-2 sm:gap-3" href="{{ lang.path }}">
      <img src="/assets/icons/web/logo.webp" width="36" height="36" alt="" class="h-9 w-9 rounded-full object-cover">
      <span class="font-display text-xl sm:text-2xl">{{ site.name }}</span>
    </a>
    <div class="flex items-center gap-2 lg:order-last">
      <a href="#book" class="btn btn-primary px-4 py-2 sm:px-5">{{ page.nav.book }}</a>
      <button type="button" class="rounded-full p-2 hover:bg-olive-fg/10 lg:hidden" data-nav-toggle aria-controls="site-nav" aria-expanded="false">
        <span class="sr-only">{{ page.nav.menu }}</span>
        {{ icon("menu", "h-6 w-6") }}
      </button>
    </div>
    <nav id="site-nav" class="site-nav hidden lg:flex" aria-label="{{ page.nav.menu }}">
      <ul class="flex flex-col items-center gap-1 lg:flex-row lg:gap-7">
        <li><a href="#villa">{{ page.nav.villa }}</a></li>
        <li><a href="#experiences">{{ page.nav.experiences }}</a></li>
        <li><a href="#gallery">{{ page.nav.gallery }}</a></li>
        <li><a href="#location">{{ page.nav.location }}</a></li>
        <li><a href="#faq">{{ page.nav.faq }}</a></li>
      </ul>
      <ul class="language-switcher" aria-label="{{ page.nav.languages }}">
        {% for language in site.languages %}
        <li>
          {% if language.code == lang.code %}
          <span aria-current="page">{{ language.short }}</span>
          {% else %}
          <a href="{{ language.path }}" hreflang="{{ language.code }}" lang="{{ language.code }}" title="{{ language.label }}">{{ language.short }}</a>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
