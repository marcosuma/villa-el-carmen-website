<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ canonical }}">
{% for code, url in alternates %}
<link rel="alternate" hreflang="{{ code }}" href="{{ url }}">
{% endfor %}
<meta name="robots" content="{{ robots }}">
<meta name="theme-color" content="#34251a">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ og_title }}">
<meta property="og:description" content="{{ og_description }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ site.base_url }}{{ site.og_image.path }}">
<meta property="og:image:width" content="{{ site.og_image.width }}">
<meta property="og:image:height" content="{{ site.og_image.height }}">
<meta property="og:locale" content="{{ lang.locale }}">
{% for other in other_languages %}
<meta property="og:locale:alternate" content="{{ other.locale }}">
{% endfor %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title }}">
<meta name="twitter:description" content="{{ og_description }}">
<meta name="twitter:image" content="{{ site.base_url }}{{ site.og_image.path }}">
<link rel="icon" type="image/png" sizes="180x180" href="/assets/icons/web/favicon.png">
<link rel="apple-touch-icon" href="/assets/icons/web/favicon.png">
<link rel="preload" href="/assets/fonts/instrument-serif-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/work-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ assets["/assets/css/site.css"] }}">
<noscript><style>.reveal{opacity:1;transform:none}</style></noscript>
