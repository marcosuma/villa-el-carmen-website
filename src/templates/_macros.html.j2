{% macro picture(img, slug, alt, sizes, class="", eager=False, full=False) -%}
{%- set image = img[slug] -%}
<img src="{{ image.src }}" srcset="{{ image.srcset }}" sizes="{{ sizes }}"
     width="{{ image.width }}" height="{{ image.height }}" alt="{{ alt }}"
     class="{{ class }}"{% if full %} data-full="{{ image.full }}"{% endif %}
     {% if eager %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
{%- endmacro %}

{#- A photo that opens full size in the lightbox: a real button, so it works with a keyboard and screen readers. -#}
{% macro zoomable(img, slug, alt, sizes, class="", button_class="") -%}
<button type="button" class="lightbox-trigger {{ button_class }}" data-lightbox aria-haspopup="dialog">
  {{ picture(img, slug, alt, sizes, class, full=True) }}
</button>
{%- endmacro %}

{% macro section_title(eyebrow, title, intro="", tone="light", centered=False) -%}
<div class="reveal{% if centered %} mx-auto max-w-3xl text-center{% else %} max-w-3xl{% endif %}">
  {% if eyebrow %}<p class="eyebrow {{ 'text-peach' if tone == 'dark' else 'text-terracotta-dark' }}">{{ eyebrow }}</p>{% endif %}
  <h2 class="section-heading">{{ title }}</h2>
  {% if intro %}<p class="mt-6 {{ 'text-lg leading-relaxed text-olive-fg/90' if tone == 'dark' else 'lead' }}">{{ intro }}</p>{% endif %}
</div>
{%- endmacro %}
